# ---- Used by docker compose (copy to .env) ----
# Password you type on the login page.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string that signs login cookies. Make one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-string
# Optional. Only needed for "Refresh prices from fal". Get it at fal.ai dashboard.
FAL_KEY=
# Set to true when you serve the site over https (recommended on a real server).
COOKIE_SECURE=false
# Port the website listens on (the API stays private inside docker).
WEB_PORT=3000
